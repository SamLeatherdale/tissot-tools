<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The stock settings theme forces a white navigation bar and dark status-bar
      icons. Parent keeps the rest of Theme.Material.Settings.
    -->
    <style name="Theme.DeviceDefault.Settings" parent="@android:style/Theme.Material.Settings">
        <item name="android:navigationBarColor">#ff121212</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorEdgeEffect">#ffffffff</item>
        <item name="android:colorForeground">#ffffffff</item>
        <item name="android:navigationBarDividerColor">#1fffffff</item>
    </style>

    <!--
      AppCompat light themes parent this style, not Theme.Material.Light itself.
      System surfaces keep the white foreground from foreground_material_light.
      Apps that paint their own white cards need the stock black foreground.
    -->
    <style name="Theme.Material.Light.NoActionBar" parent="@android:style/Theme.Material.Light">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:colorForeground">#ff000000</item>
    </style>
</resources>
